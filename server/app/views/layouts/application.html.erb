<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Folio — private library" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="application-name" content="Folio">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f4efe3" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#171310" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <header class="site-header">
        <%= link_to root_path, class: "wordmark" do %>
          Folio<span class="fleuron">&nbsp;❧</span>
        <% end %>
        <span class="tagline">Private library</span>
        <nav>
          <%= link_to "Library", root_path, class: "top-link top-link--nav",
                aria: { current: current_page?(root_path) ? "page" : nil } %>
          <%= link_to "Series", series_index_path, class: "top-link top-link--nav",
                aria: { current: current_page?(series_index_path) ? "page" : nil } %>
          <%= link_to "Reading", reading_path, class: "top-link top-link--nav",
                aria: { current: current_page?(reading_path) ? "page" : nil } %>
          <%= link_to "Upload", new_upload_path, class: "top-link top-link--nav",
                aria: { current: current_page?(new_upload_path) ? "page" : nil } %>
          <%= link_to "Catalog", library_scan_path, class: "top-link top-link--nav",
                aria: { current: current_page?(library_scan_path) ? "page" : nil } %>
          <%= link_to "Duplicates", duplicates_path, class: "top-link top-link--nav",
                aria: { current: current_page?(duplicates_path) ? "page" : nil } %>
          <%= link_to "Devices", devices_path, class: "top-link top-link--nav",
                aria: { current: current_page?(devices_path) ? "page" : nil } %>
          <%= button_to "Sign out", session_path, method: :delete, class: "top-link" %>
        </nav>
      </header>
    <% end %>

    <main>
      <% if notice.present? %><p class="flash" role="status"><%= notice %></p><% end %>
      <% if alert.present? %><p class="flash flash--alert" role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>

    <% if authenticated? %>
      <nav class="bottom-nav" aria-label="Primary">
        <%= link_to "Library", root_path, aria: { current: current_page?(root_path) ? "page" : nil } %>
        <%= link_to "Series", series_index_path, aria: { current: current_page?(series_index_path) ? "page" : nil } %>
        <%= link_to "Reading", reading_path, aria: { current: current_page?(reading_path) ? "page" : nil } %>
        <%= link_to "Upload", new_upload_path, aria: { current: current_page?(new_upload_path) ? "page" : nil } %>
      </nav>
    <% end %>
  </body>
</html>
