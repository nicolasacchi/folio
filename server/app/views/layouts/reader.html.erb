<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "#{@book.title} — Folio" %></title>
    <%# Pinch-zoom stays enabled so image/comic pages can be zoomed on mobile;
    double-tap zoom is still off because .reader-root sets touch-action. %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#f4efe3" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#171310" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Bulk-includes every app/assets/**/*.css file (propshaft :app),
        i.e. application.css (design tokens) plus reader.css below — see
        Propshaft::Helper#stylesheet_link_tag. %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="reader-body">
    <%= yield %>
  </body>
</html>
