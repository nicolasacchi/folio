<% content_for :title, "#{@book.title} — Reading" %>

<%= turbo_frame_tag "reader_frame", class: "reader-frame" do %>
  <% if @file %>
    <div id="reader-root" class="reader-root"
         data-controller="reader"
         data-reader-file-url-value="<%= read_book_file_path(@book) %>"
         data-reader-filename-value="<%= @file.filename %>"
         data-reader-format-value="<%= @file.format %>"
         data-reader-book-id-value="<%= @book.id %>"
         data-reader-public-id-value="<%= @book.public_id %>"
         data-reader-position-url-value="<%= read_book_position_path(@book) %>"
         data-reader-state-url-value="<%= read_book_state_path(@book) %>"
         data-reader-annotations-url-value="/books/<%= @book.id %>/read/annotations"
         data-reader-lookup-url-value="<%= lookup_path %>"
         data-reader-vocab-url-value="<%= vocab_entries_path %>"
         data-reader-book-lang-value="<%= @book_lang %>"
         data-reader-csrf-token-value="<%= form_authenticity_token %>"
         data-reader-preferences-url-value="<%= reader_preferences_path %>"
         data-reader-server-preferences-value="<%= ERB::Util.html_escape(@reader_preferences.to_json) %>"
         data-reader-cfi-value="<%= @initial_position&.cfi %>"
         data-reader-fraction-value="<%= @initial_position&.fraction %>"
         <% if @text_length %>data-reader-text-length-value="<%= @text_length %>"<% end %>>

      <div class="reader-loading" data-reader-target="loading">
        <div class="reader-loading__spinner" aria-hidden="true"></div>
        <p>Opening “<%= @book.title %>”…</p>
      </div>

      <div class="reader-viewport" data-reader-target="viewport"></div>

      <button type="button" class="reader-page-arrow reader-page-arrow--left" data-action="click->reader#prevPage" aria-label="Previous page" tabindex="-1">
        <%= render "reader/icon", name: "chevron-left" %>
      </button>
      <button type="button" class="reader-page-arrow reader-page-arrow--right" data-action="click->reader#nextPage" aria-label="Next page" tabindex="-1">
        <%= render "reader/icon", name: "chevron-right" %>
      </button>

      <div class="reader-bar reader-bar--top" data-reader-target="topBar">
        <div class="reader-bar-nav">
          <%= link_to book_path(@book), class: "reader-icon-btn", data: { turbo: false },
                aria: { label: "Back to book page" }, title: "Back to book page" do %>
            <%= render "reader/icon", name: "arrow-left" %>
          <% end %>
          <%= link_to root_path, class: "reader-icon-btn reader-btn-library", data: { turbo: false },
                aria: { label: "Library" }, title: "Library" do %>
            <%= render "reader/icon", name: "library" %>
          <% end %>
        </div>
        <span class="reader-title"><%= @book.title %></span>
        <div class="reader-bar-actions">
          <button type="button" class="reader-icon-btn" data-action="reader#openToc" aria-label="Table of contents" title="Contents">
            <%= render "reader/icon", name: "list" %>
          </button>
          <button type="button" class="reader-icon-btn" data-action="reader#openAnnotations" aria-label="Highlights and notes" title="Highlights &amp; notes">
            <%= render "reader/icon", name: "sticky-note" %>
          </button>
          <button type="button" class="reader-icon-btn" data-action="reader#openSearch" aria-label="Search in book" title="Search">
            <%= render "reader/icon", name: "search" %>
          </button>
          <button type="button" class="reader-icon-btn reader-icon-btn--glyph" data-action="reader#openSettings" aria-label="Display settings" title="Display settings">Aa</button>
          <button type="button" class="reader-icon-btn reader-icon-btn--fullscreen" data-reader-target="fullscreenButton"
                  data-action="reader#toggleFullscreen" aria-label="Toggle full screen" title="Toggle full screen" hidden>
            <%= render "reader/icon", name: "maximize" %>
            <%= render "reader/icon", name: "minimize" %>
          </button>
        </div>
      </div>

      <div class="reader-bar reader-bar--bottom" data-reader-target="bottomBar">
        <input type="range" class="reader-progress" min="0" max="1" step="0.001" value="0"
               data-reader-target="progressSlider"
               data-action="input->reader#onProgressInput change->reader#onProgressChange"
               aria-label="Reading progress">
        <div class="reader-readout" data-reader-target="readout"></div>
      </div>

      <div class="reader-sync-banner" data-reader-target="syncBanner" role="status" aria-label="Kindle sync"></div>
      <div class="reader-sync-toast" data-reader-target="syncToast" role="status" aria-label="Kindle sync"></div>

      <div class="reader-backdrop" data-reader-target="backdrop" data-action="click->reader#closePanels"></div>

      <nav class="reader-drawer reader-drawer--toc" data-reader-target="tocPanel" aria-label="Table of contents">
        <div class="reader-panel-header">
          <h2>Contents</h2>
          <button type="button" class="reader-icon-btn" data-action="reader#closePanels" aria-label="Close" title="Close">
            <%= render "reader/icon", name: "x" %>
          </button>
        </div>
        <div class="reader-toc-list" data-reader-target="tocList"></div>
      </nav>

      <div class="reader-drawer reader-drawer--search" data-reader-target="searchPanel" aria-label="Search in book">
        <div class="reader-panel-header">
          <h2>Search</h2>
          <button type="button" class="reader-icon-btn" data-action="reader#closePanels" aria-label="Close" title="Close">
            <%= render "reader/icon", name: "x" %>
          </button>
        </div>
        <input type="search" class="reader-search-input" placeholder="Search this book…"
               data-reader-target="searchInput" data-action="input->reader#onSearchInput">
        <div class="reader-search-status" data-reader-target="searchStatus"></div>
        <div class="reader-search-results" data-reader-target="searchResults"></div>
      </div>

      <nav class="reader-drawer reader-drawer--annotations" data-reader-target="annotationsPanel" aria-label="Highlights and notes">
        <div class="reader-panel-header">
          <h2>Highlights &amp; Notes</h2>
          <button type="button" class="reader-icon-btn" data-action="reader#closePanels" aria-label="Close" title="Close">
            <%= render "reader/icon", name: "x" %>
          </button>
        </div>
        <div class="reader-annotations-list" data-reader-target="annotationsList"></div>
      </nav>

      <div class="reader-sheet" data-reader-target="settingsPanel" aria-label="Display settings">
        <div class="reader-panel-header">
          <h2>Display</h2>
          <button type="button" class="reader-icon-btn" data-action="reader#closePanels" aria-label="Close" title="Close">
            <%= render "reader/icon", name: "x" %>
          </button>
        </div>

        <div class="reader-settings-row">
          <label>Text size</label>
          <div class="reader-stepper">
            <button type="button" class="reader-icon-btn" data-action="reader#decreaseFontSize" aria-label="Smaller text">A-</button>
            <span data-reader-target="fontSizeReadout">100%</span>
            <button type="button" class="reader-icon-btn" data-action="reader#increaseFontSize" aria-label="Larger text">A+</button>
          </div>
        </div>

        <div class="reader-settings-row">
          <label for="reader-line-height">Line height</label>
          <input type="range" id="reader-line-height" min="1.2" max="2.4" step="0.1" value="1.5"
                 data-reader-target="lineHeightSlider" data-action="input->reader#onLineHeightInput">
          <span data-reader-target="lineHeightReadout">1.5</span>
        </div>

        <div class="reader-settings-row">
          <label for="reader-margin">Margins</label>
          <input type="range" id="reader-margin" min="0" max="64" step="4" value="24"
                 data-reader-target="marginSlider" data-action="input->reader#onMarginInput">
          <span data-reader-target="marginReadout">24px</span>
        </div>

        <div class="reader-settings-row reader-settings-row--fonts">
          <label>Font</label>
          <div class="reader-font-chips">
            <button type="button" class="reader-toggle reader-font-chip reader-font-chip--publisher" data-reader-target="fontButton"
                    data-action="reader#setFontFamily" data-reader-font-param="publisher">Publisher</button>
            <button type="button" class="reader-toggle reader-font-chip reader-font-chip--serif" data-reader-target="fontButton"
                    data-action="reader#setFontFamily" data-reader-font-param="serif">Serif</button>
            <button type="button" class="reader-toggle reader-font-chip reader-font-chip--sans" data-reader-target="fontButton"
                    data-action="reader#setFontFamily" data-reader-font-param="sans">Sans</button>
            <button type="button" class="reader-toggle reader-font-chip reader-font-chip--literata" data-reader-target="fontButton"
                    data-action="reader#setFontFamily" data-reader-font-param="literata">Literata</button>
            <button type="button" class="reader-toggle reader-font-chip reader-font-chip--bitter" data-reader-target="fontButton"
                    data-action="reader#setFontFamily" data-reader-font-param="bitter">Bitter</button>
            <button type="button" class="reader-toggle reader-font-chip reader-font-chip--garamond" data-reader-target="fontButton"
                    data-action="reader#setFontFamily" data-reader-font-param="garamond">EB Garamond</button>
            <button type="button" class="reader-toggle reader-font-chip reader-font-chip--atkinson" data-reader-target="fontButton"
                    data-action="reader#setFontFamily" data-reader-font-param="atkinson">Atkinson</button>
            <button type="button" class="reader-toggle reader-font-chip reader-font-chip--opendyslexic" data-reader-target="fontButton"
                    data-action="reader#setFontFamily" data-reader-font-param="opendyslexic">OpenDyslexic</button>
          </div>
        </div>

        <div class="reader-settings-row">
          <label>Justify</label>
          <div class="reader-toggle-group">
            <button type="button" class="reader-toggle" data-reader-target="justifyButton"
                    data-action="reader#setJustify" data-reader-justify-param="false">Off</button>
            <button type="button" class="reader-toggle" data-reader-target="justifyButton"
                    data-action="reader#setJustify" data-reader-justify-param="true">On</button>
          </div>
        </div>

        <div class="reader-settings-row">
          <label>Hyphenation</label>
          <div class="reader-toggle-group">
            <button type="button" class="reader-toggle" data-reader-target="hyphenateButton"
                    data-action="reader#setHyphenate" data-reader-hyphenate-param="false">Off</button>
            <button type="button" class="reader-toggle" data-reader-target="hyphenateButton"
                    data-action="reader#setHyphenate" data-reader-hyphenate-param="true">On</button>
          </div>
        </div>

        <div class="reader-settings-row">
          <label>Theme</label>
          <div class="reader-toggle-group">
            <button type="button" class="reader-toggle" data-reader-target="themeButton"
                    data-action="reader#setTheme" data-reader-theme-param="light">Light</button>
            <button type="button" class="reader-toggle" data-reader-target="themeButton"
                    data-action="reader#setTheme" data-reader-theme-param="sepia">Sepia</button>
            <button type="button" class="reader-toggle" data-reader-target="themeButton"
                    data-action="reader#setTheme" data-reader-theme-param="dark">Dark</button>
          </div>
        </div>

        <div class="reader-settings-row">
          <label>Layout</label>
          <div class="reader-toggle-group">
            <button type="button" class="reader-toggle" data-reader-target="flowButton"
                    data-action="reader#setFlow" data-reader-flow-param="paginated">Paginated</button>
            <button type="button" class="reader-toggle" data-reader-target="flowButton"
                    data-action="reader#setFlow" data-reader-flow-param="scrolled">Scrolled</button>
          </div>
        </div>
      </div>

      <div class="reader-sheet reader-note-sheet" data-reader-target="noteSheet" aria-label="Note">
        <div class="reader-panel-header">
          <h2>Note</h2>
          <button type="button" class="reader-icon-btn" data-action="reader#closePanels" aria-label="Close" title="Close">
            <%= render "reader/icon", name: "x" %>
          </button>
        </div>
        <div class="reader-note-sheet__body">
          <textarea class="reader-note-textarea" data-reader-target="noteTextarea" rows="4" placeholder="Add a note…"></textarea>
          <div class="reader-note-sheet__actions">
            <button type="button" class="btn btn--quiet" data-action="reader#closePanels">Cancel</button>
            <button type="button" class="btn btn--primary" data-action="reader#saveNote">Save</button>
          </div>
        </div>
      </div>

      <div class="reader-floating reader-selection-menu" data-reader-target="selectionMenu" aria-label="Selection actions">
        <button type="button" class="reader-selection-dot reader-selection-dot--yellow"
                data-action="reader#highlightSelection" data-reader-color-param="yellow" aria-label="Highlight yellow"></button>
        <button type="button" class="reader-selection-dot reader-selection-dot--blue"
                data-action="reader#highlightSelection" data-reader-color-param="blue" aria-label="Highlight blue"></button>
        <button type="button" class="reader-selection-dot reader-selection-dot--pink"
                data-action="reader#highlightSelection" data-reader-color-param="pink" aria-label="Highlight pink"></button>
        <button type="button" class="reader-selection-dot reader-selection-dot--orange"
                data-action="reader#highlightSelection" data-reader-color-param="orange" aria-label="Highlight orange"></button>
        <button type="button" class="reader-selection-action" data-action="reader#noteSelection">Note</button>
        <button type="button" class="reader-selection-action" data-action="reader#lookupSelection">Look up</button>
        <button type="button" class="reader-selection-action" data-action="reader#copySelection">Copy</button>
      </div>

      <div class="reader-floating reader-annotation-popover" data-reader-target="annotationPopover" aria-label="Annotation">
        <button type="button" class="reader-icon-btn reader-annotation-popover__close"
                data-action="reader#closeAnnotationPopover" aria-label="Close" title="Close">
          <%= render "reader/icon", name: "x" %>
        </button>
        <div class="reader-annotation-popover__body" data-reader-target="annotationPopoverBody"></div>
      </div>

      <div class="reader-floating reader-lookup-card" data-reader-target="lookupCard" aria-label="Dictionary">
        <div class="reader-lookup-card__tabs">
          <button type="button" class="reader-lookup-tab" data-reader-target="lookupTabDictionary"
                  data-action="reader#showLookupDictionaryTab" aria-pressed="true">Dictionary</button>
          <button type="button" class="reader-lookup-tab" data-reader-target="lookupTabWikipedia"
                  data-action="reader#showLookupWikipediaTab" aria-pressed="false">Wikipedia</button>
          <button type="button" class="reader-icon-btn reader-lookup-card__close"
                  data-action="reader#closeLookupCard" aria-label="Close" title="Close">
            <%= render "reader/icon", name: "x" %>
          </button>
        </div>
        <div class="reader-lookup-card__pane" data-reader-target="lookupDictionaryPane"></div>
        <div class="reader-lookup-card__pane" data-reader-target="lookupWikipediaPane" hidden></div>
      </div>
    </div>
  <% elsif @preparing_conversion %>
    <div class="reader-empty" data-controller="poll reader-preparing"
         data-poll-interval-value="4000"
         data-reader-preparing-started-at-value="<%= @preparing_conversion.created_at.to_i %>"
         data-reader-preparing-timeout-value="<%= ReaderController::PREPARING_TIMEOUT_MS %>">
      <div class="reader-preparing-step" data-reader-preparing-target="waiting">
        <div class="reader-loading__spinner" aria-hidden="true"></div>
        <p>Preparing a readable copy…</p>
        <p class="small">Preparing this book for reading — this can take a minute. It's converting to EPUB in the background, and this page refreshes itself.</p>
      </div>
      <div class="reader-preparing-step" data-reader-preparing-target="timedOut" hidden>
        <p>Still preparing — this is taking longer than expected.</p>
        <p class="small">The conversion may have stalled. You can keep waiting, try again, or head back to the book.</p>
        <button type="button" class="btn" data-action="reader-preparing#retry">Try again</button>
      </div>
      <%= link_to "← Back to book", book_path(@book), class: "btn btn--quiet", data: { turbo: false } %>
    </div>
  <% else %>
    <div class="reader-empty">
      <p>No readable file for this book yet.</p>
      <%= link_to "← Back to book", book_path(@book), class: "btn btn--quiet", data: { turbo: false } %>
    </div>
  <% end %>
<% end %>
