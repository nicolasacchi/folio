<% content_for :title, "Folio — series" %>

<p class="kicker">Card catalog</p>
<h1 class="page-title">Series</h1>

<% if @series.empty? %>
  <div class="empty-state">
    <span class="fleuron">❧</span>
    No series in the library yet.
  </div>
<% else %>
  <p class="muted small"><%= pluralize(@series.size, "series") %></p>
  <div class="shelf">
    <% @series.each do |name, count| %>
      <%= link_to root_path(series: name), class: "shelf-item", title: name do %>
        <%= render "books/cover", book: @covers[name] %>
        <span class="shelf-caption">
          <span class="t"><%= name %></span>
          <span class="a"><%= pluralize(count, "book") %></span>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>
