<% content_for :title, "Folio — catalog" %>

<p class="kicker">Accessions & housekeeping</p>
<h1 class="page-title">Catalog</h1>

<% if @roots.empty? %>
  <p class="muted">No scan roots configured. Set <code>SCAN_ROOTS</code> to a comma-separated
  list of folders and restart the server.</p>
<% else %>
  <p class="muted small">
    Watching <% @roots.each do |root| %><code><%= root %></code> <% end %>—
    books are referenced in place (never copied or deleted), deduplicated by checksum,
    and rescanned nightly. Metadata comes from Calibre sidecars where present.
  </p>

  <%= turbo_frame_tag "library_scan_status" do %>
  <div class="actions">
    <% scanning = @progress && @progress[:state] == "running" %>
    <%= button_to scanning ? "Scan running…" : "Scan now", library_scan_path,
          class: "btn btn--primary", disabled: scanning, form: { data: { turbo_frame: "_top" } } %>
    <% if (@counts["missing"] || 0).positive? %>
      <%= button_to "Prune missing files", prune_library_scan_path, class: "btn btn--danger",
            form: { data: { turbo_frame: "_top", turbo_confirm: "Remove all missing files (and emptied books) from the library? The source files stay untouched." } } %>
    <% end %>
  </div>

  <% if @progress %>
    <p class="section-label">Last scan</p>
    <p class="meta-list small">
      <b><%= @progress[:state] %></b>
      <% if @progress[:state] == "running" && (@progress[:total] || 0).positive? %>
        · <%= @progress[:done] %> / <%= @progress[:total] %> new files processed
      <% end %>
      <% if @progress[:started_at] %>
        · started <%= time_ago_in_words(Time.zone.at(@progress[:started_at])) %> ago
      <% end %>
      <% if @progress[:finished_at] %>
        · finished <%= time_ago_in_words(Time.zone.at(@progress[:finished_at])) %> ago
      <% end %>
      <% if @progress[:error] %>
        · <span class="stamp stamp--failed">error</span> <code class="small"><%= @progress[:error] %></code>
      <% end %>
    </p>
    <% if @progress[:state] == "done" && @progress[:counts] %>
      <p class="meta-list small">
        <span class="stamp stamp--ready"><%= number_with_delimiter(@progress[:counts][:imported] || 0) %> imported</span>
        <span class="stamp"><%= number_with_delimiter(@progress[:counts][:duplicate] || 0) %> duplicate</span>
        <% if (@progress[:counts][:relocated] || 0).positive? %>
          <span class="stamp"><%= number_with_delimiter(@progress[:counts][:relocated]) %> relocated</span>
        <% end %>
      </p>
    <% end %>
    <% if @progress[:state] == "running" %>
      <div data-controller="poll" data-poll-interval-value="5000"></div>
    <% end %>
  <% end %>

  <p class="section-label">Ledger</p>
  <% if @total.zero? %>
    <p class="muted small">Nothing scanned yet.</p>
  <% else %>
    <p class="meta-list small">
      <% ImportFile::STATUSES.each do |status| %>
        <% next unless @counts[status] %>
        <span class="stamp <%= "stamp--ready" if status == "imported" %> <%= "stamp--failed" if %w[failed missing].include?(status) %>"><%= status %> <%= number_with_delimiter(@counts[status]) %></span>
      <% end %>
    </p>
  <% end %>

  <% if @problems.any? %>
    <p class="section-label">Needs attention</p>
    <% @problems.each do |entry| %>
      <div class="file-row">
        <span class="stamp stamp--failed"><%= entry.status %></span>
        <span class="grow small mono" style="word-break: break-all;"><%= entry.path %></span>
        <% if entry.message.present? %>
          <span class="small muted"><%= truncate(entry.message, length: 120) %></span>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <p class="section-label">Catalog operations</p>
  <% if @catalog_progress %>
    <p class="meta-list small">
      last batch: <b><%= @catalog_progress[:operation] %></b> · <%= @catalog_progress[:state] %>
      <% if @catalog_progress[:queued] %> · <%= number_with_delimiter(@catalog_progress[:queued]) %> queued<% end %>
      <% if @catalog_progress[:merged] %> · <%= number_with_delimiter(@catalog_progress[:merged]) %> merged<% end %>
      <% if @catalog_progress[:embedded] %> · <%= number_with_delimiter(@catalog_progress[:embedded]) %> embedded<% end %>
      <% if @catalog_progress[:error] %> · <span class="stamp stamp--failed"><%= @catalog_progress[:error] %></span><% end %>
    </p>
  <% end %>
  <p class="meta-list small">
    <span class="stamp"><%= number_with_delimiter(@catalog[:queued]) %> jobs queued</span>
    <% if @catalog[:embedded] %>
      <span class="stamp"><%= number_with_delimiter(@catalog[:embedded]) %> / <%= number_with_delimiter(@catalog[:books]) %> embedded</span>
    <% end %>
    <% if @catalog[:failed_conversions].positive? %>
      <span class="stamp stamp--failed"><%= number_with_delimiter(@catalog[:failed_conversions]) %> failed conversions</span>
    <% end %>
  </p>
  <div class="actions">
    <%= button_to "Convert all to Kindle (#{number_with_delimiter(@catalog[:to_convert])})", catalog_convert_all_path,
          class: "btn btn--primary", disabled: @catalog[:to_convert].zero?,
          form: { data: { turbo_frame: "_top", turbo_confirm: "Queue an AZW3 conversion for #{number_with_delimiter(@catalog[:to_convert])} books? They convert one at a time in the background (roughly a day per 10k books); converted copies land in Folio's own storage. You can cancel queued work anytime." } } %>
    <%= button_to "Index full text (#{number_with_delimiter(@catalog[:fulltext_missing])})", catalog_index_fulltext_path,
          class: "btn", disabled: @catalog[:fulltext_missing].zero?,
          form: { data: { turbo_frame: "_top", turbo_confirm: "Queue Calibre text extraction for #{number_with_delimiter(@catalog[:fulltext_missing])} books so search can look inside them? Runs serially in the background; shares the conversion queue." } } %>
    <%= button_to "Merge all duplicates (#{number_with_delimiter(@catalog[:duplicate_groups])} groups)", catalog_merge_duplicates_path,
          class: "btn", disabled: @catalog[:duplicate_groups].zero?,
          form: { data: { turbo_frame: "_top", turbo_confirm: "Merge every duplicate-editions group into its best edition (most formats, then cover, then oldest)? Conflicting formats stay put; source-folder files are never touched." } } %>
    <%= button_to "Enrich metadata (#{number_with_delimiter(@catalog[:to_enrich])})", catalog_enrich_all_path,
          class: "btn", disabled: @catalog[:to_enrich].zero?,
          form: { data: { turbo_frame: "_top", turbo_confirm: "Look up #{number_with_delimiter(@catalog[:to_enrich])} books on Open Library / Google Books to fill in missing descriptions, years and covers? Only blank fields are written; runs at ~1 lookup/second in the background." } } %>
    <% if @catalog[:embedded] %>
      <%= button_to "Rebuild semantic vectors", catalog_embed_all_path,
            class: "btn",
            form: { data: { turbo_frame: "_top", turbo_confirm: "Re-embed the whole catalog for semantic search and similar-books? Takes a few minutes; runs locally." } } %>
    <% end %>
    <%= button_to "Cancel queued work (#{number_with_delimiter(@catalog[:queued])})", catalog_cancel_queued_path,
          class: "btn btn--danger", disabled: @catalog[:queued].zero?,
          form: { data: { turbo_frame: "_top", turbo_confirm: "Cancel all queued batch jobs? Running work finishes; completed conversions keep their files." } } %>
  </div>
  <% end %>
<% end %>
