<%# Strict-allowlist inline SVG icons for the main app chrome (as opposed to
    server/app/views/reader/_icon.html.erb, the reader page's own set).
    Usage: render "shared/icon", name: "book-open". 24x24, Lucide-style
    stroke geometry, one svg per call — sizing lives in application.css
    (.app-icon / .btn .app-icon). Keep the allowlist to icons actually
    used; unknown names are a bug, not a silent no-render. %>
<%
  icon_names = %w[
    book-open download send pencil text-search scan-text file-text trash x star clock check undo
  ]
  raise ArgumentError, "Unknown icon: #{name.inspect}" unless icon_names.include?(name)
%>
<% if name == "star" %>
<svg class="app-icon app-icon--star" viewBox="0 0 24 24" width="24" height="24"
     fill="currentColor" stroke="none" aria-hidden="true" focusable="false">
  <path d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5-4.7-4.6 6.5-.9z"/>
</svg>
<% else %>
<svg class="app-icon app-icon--<%= name %>" viewBox="0 0 24 24" width="24" height="24"
     fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <% case name
  when "book-open" %>
    <path d="M12 6.5c-1.6-1.3-3.6-2-6-2H3v13.5h3c2.4 0 4.4.7 6 2z"/>
    <path d="M12 6.5c1.6-1.3 3.6-2 6-2h3v13.5h-3c-2.4 0-4.4.7-6 2z"/>
  <% when "download" %>
    <line x1="12" y1="3" x2="12" y2="14"/>
    <polyline points="7 10 12 15 17 10"/>
    <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
  <% when "send" %>
    <path d="M21 3 3 10.2l7 2.4 2.2 7.4z"/>
    <line x1="10.2" y1="12.6" x2="21" y2="3"/>
  <% when "pencil" %>
    <path d="M4 20l.8-3.8L15.2 5.8l3 3L7.8 19.2z"/>
    <line x1="13.6" y1="7.4" x2="16.6" y2="10.4"/>
  <% when "text-search" %>
    <line x1="4" y1="6" x2="15" y2="6"/>
    <line x1="4" y1="10.5" x2="11.5" y2="10.5"/>
    <line x1="4" y1="15" x2="9" y2="15"/>
    <circle cx="16" cy="16.5" r="4"/>
    <line x1="19" y1="19.5" x2="21.5" y2="22"/>
  <% when "scan-text" %>
    <path d="M3 8V6a2 2 0 0 1 2-2h2"/>
    <path d="M17 4h2a2 2 0 0 1 2 2v2"/>
    <path d="M21 16v2a2 2 0 0 1-2 2h-2"/>
    <path d="M7 20H5a2 2 0 0 1-2-2v-2"/>
    <line x1="7" y1="9" x2="17" y2="9"/>
    <line x1="7" y1="12.5" x2="17" y2="12.5"/>
    <line x1="7" y1="16" x2="13" y2="16"/>
  <% when "file-text" %>
    <path d="M13.5 2.5H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8L13.5 2.5z"/>
    <polyline points="13.5 2.5 13.5 8 19 8"/>
    <line x1="8.5" y1="12.5" x2="15.5" y2="12.5"/>
    <line x1="8.5" y1="16" x2="15.5" y2="16"/>
  <% when "trash" %>
    <line x1="4" y1="7" x2="20" y2="7"/>
    <path d="M6 7V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v3"/>
    <path d="M19 7l-1 13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1L5 7"/>
    <line x1="10" y1="11" x2="10" y2="17"/>
    <line x1="14" y1="11" x2="14" y2="17"/>
  <% when "x" %>
    <line x1="18" y1="6" x2="6" y2="18"/>
    <line x1="6" y1="6" x2="18" y2="18"/>
  <% when "clock" %>
    <circle cx="12" cy="12" r="9"/>
    <polyline points="12 7 12 12 16 14"/>
  <% when "check" %>
    <polyline points="4 12 9 17 20 6"/>
  <% when "undo" %>
    <path d="M9 14 4 9l5-5"/>
    <path d="M4 9h10a6 6 0 0 1 0 12h-3"/>
  <% end %>
</svg>
<% end %>
