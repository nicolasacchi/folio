<% content_for :title, "#{@book.title} — Folio" %>
<%= turbo_stream_from @book %>

<div class="book-sheet">
  <%= render "cover", book: @book %>

  <div>
    <% if @book.series.present? %>
      <p class="kicker">
        <%= link_to @book.series, root_path(series: @book.series) %>
        <%= @book.series_index&.round == @book.series_index ? @book.series_index&.to_i : @book.series_index %>
      </p>
    <% else %>
      <p class="kicker">In the library</p>
    <% end %>
    <h1 class="page-title"><%= @book.title %></h1>
    <% if @book.category.present? %>
      <p class="breadcrumb">
        <%= link_to Library::Taxonomy.label_for(@book.category_root), root_path(category_root: @book.category_root) %>
        <% if @book.category_parts.size > 1 %>
          <span aria-hidden="true"> / </span>
          <%= link_to Library::Taxonomy.sub_label_for(@book.category_root, @book.category_parts.last), root_path(category: @book.category) %>
        <% end %>
      </p>
    <% end %>
    <p class="book-author">
      <% if @book.author.present? %>
        <%= link_to @book.author, root_path(author: @book.author, sort: "title") %>
      <% else %>
        <%= @book.display_author %>
      <% end %>
    </p>

    <%# Each fact links to the library filtered on it, like the author. %>
    <p class="meta-list small">
      <% if @book.language.present? %>
        <%= link_to tag.b(@book.language), root_path(language: @book.language),
              title: "All books in this language" %> ·
      <% end %>
      <% if @book.published_year.present? %>
        <%= link_to @book.published_year, root_path(year: @book.published_year),
              title: "All books published in #{@book.published_year}" %> ·
      <% end %>
      <%= link_to "added #{l @book.created_at.to_date, format: :long}",
            root_path(added: @book.created_at.to_date.iso8601),
            title: "Everything added that day" %>
    </p>

    <div class="action-deck">
      <div class="action-row">
        <% if @book.readable_file || @book.book_files.any? %>
          <%= link_to read_book_path(@book), class: "btn btn--primary" do %>
            <%= render "shared/icon", name: "book-open" %>Read in browser
          <% end %>
          <%# The reader serves the OCR text layer by default when there is
              one (see BookFile#read_source_path) — offer the untouched scan
              too, for whoever specifically wants it, as an equally visible
              secondary action (not a muted afterthought — nobody found the
              one-word link this used to be). %>
          <% if @book.readable_file&.ocr_fresh? %>
            <%= link_to read_book_path(@book, raw: 1), class: "btn",
                  title: "Open the scanned original, without the OCR text layer" do %>
              <%= render "shared/icon", name: "scan-text" %>Original scan
            <% end %>
          <% end %>
          <%# The text-only companion (see Library::TextCompanion,
              TextCompanionJob) only ever applies to a pdf that's actually
              this book's readable_file — same "no dead link on a
              mixed-format book" guard as the Original scan button above (a
              richer preferred format means #readable_file isn't this pdf,
              so #text_fresh? there would just be about a file the reader
              never opens). %>
          <% if (text_source = @book.text_companion_source_file) && @book.readable_file == text_source %>
            <% if text_source.text_fresh? %>
              <%= link_to read_book_path(@book, text: 1), class: "btn",
                    title: "Open the plain-text reflow version" do %>
                <%= render "shared/icon", name: "file-text" %>Text only
              <% end %>
            <% elsif @book.conversions.active.exists?(kind: "text") %>
              <span class="stamp stamp--pending">building text version…</span>
            <% else %>
              <%= button_to build_text_book_path(@book), class: "btn btn--quiet",
                    title: "Extract a plain-text reflow version and build its Kindle AZW3" do %>
                <%= render "shared/icon", name: "file-text" %>Build text version
              <% end %>
            <% end %>
          <% end %>
        <% end %>
        <% if (kindle_file = @book.kindle_file) %>
          <%= link_to download_book_path(@book, fmt: kindle_file.format), class: "btn", data: { turbo: false } do %>
            <%= render "shared/icon", name: "download" %>Download <%= kindle_file.format.upcase %>
          <% end %>
        <% end %>
      </div>

      <% if @devices.any? %>
        <%# The device gets the OCR text layer by default when the kindle_file
            has one (see BookFile#delivery_path) — offer a per-device "send
            the untouched scan instead" affordance next to it, and its
            mirror once that switch has been made ("text layer", variant=
            auto, to switch back); likewise a "send the text-only version
            instead" affordance once the kindle_file is a pdf (see
            Book#text_companion_source_file) — the AZW3 doesn't need to
            exist yet, sending "text" alone queues its build and the
            device gets the plain pdf in the meantime (see
            DeliveriesController, BookFile#delivery_path's "text" branch).
            Only where a send is still pending (nothing on the device
            would need undoing) or already delivered (switching needs no
            extra plumbing: the manifest sha changes and kindled
            re-fetches, see Delivery#variant); skipped entirely while an
            eviction is queued (that state's own "Keep" action already
            un-does the pending removal — a second, unrelated action there
            would be confusing). %>
        <% ocr_original = @book.kindle_file&.ocr_fresh? %>
        <% text_capable = @book.text_companion_source_file.present? %>
        <div class="action-row">
          <% @devices.each do |device| %>
            <% delivery = @deliveries[device.id] %>
            <% preferred = device.id == @preferred_device_id %>
            <% if delivery.nil? || delivery.removed? %>
              <%= button_to deliveries_path(book_id: @book.id, device_id: device.id), class: "btn" do %>
                <%= render "shared/icon", name: "send" %>Send to <%= device.name %><% if preferred %><%= render "shared/icon", name: "star" %><span class="visually-hidden">(preferred)</span><% end %>
              <% end %>
              <% if ocr_original %>
                <%= button_to deliveries_path(book_id: @book.id, device_id: device.id, variant: "original"), class: "small muted link-quiet",
                      title: "Send the untouched scan to #{device.name}, without the OCR text layer" do %>send original scan<% end %>
              <% end %>
              <% if text_capable %>
                <%= button_to deliveries_path(book_id: @book.id, device_id: device.id, variant: "text"), class: "small muted link-quiet",
                      title: "Send the plain-text reflow version to #{device.name} instead" do %>send text only<% end %>
              <% end %>
            <% elsif delivery.evict_requested? %>
              <%= button_to eviction_path(delivery_id: delivery.id), method: :delete, class: "btn btn--quiet",
                    title: "Queued for deletion on next sync — click to keep it" do %>
                <%= render "shared/icon", name: "undo" %>Keep on <%= device.name %><% if preferred %><%= render "shared/icon", name: "star" %><span class="visually-hidden">(preferred)</span><% end %>
              <% end %>
            <% elsif delivery.delivered? %>
              <%= button_to evictions_path(delivery_id: delivery.id), class: "btn btn--quiet btn--evict",
                    title: "Delete from the device on next sync",
                    form: { data: { turbo_confirm: "Delete “#{@book.title}” from #{device.name} on next sync?" } } do %>
                <%= render "shared/icon", name: "check" %>On <%= device.name %><% if preferred %><%= render "shared/icon", name: "star" %><span class="visually-hidden">(preferred)</span><% end %><%= render "shared/icon", name: "x" %>
              <% end %>
              <%= render "device_variant_switches", device: device, delivery: delivery,
                    ocr_original: ocr_original, text_capable: text_capable %>
            <% else %>
              <%= button_to delivery_path(delivery), method: :delete, class: "btn btn--quiet btn--evict",
                    title: "Remove from queue" do %>
                <%= render "shared/icon", name: "clock" %>Queued <%= device.name %><% if preferred %><%= render "shared/icon", name: "star" %><span class="visually-hidden">(preferred)</span><% end %><%= render "shared/icon", name: "x" %>
              <% end %>
              <%= render "device_variant_switches", device: device, delivery: delivery,
                    ocr_original: ocr_original, text_capable: text_capable %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div class="action-row">
        <%= link_to edit_book_path(@book), class: "btn btn--quiet" do %>
          <%= render "shared/icon", name: "pencil" %>Edit
        <% end %>
        <%# Full-text search is opt-in per book (see IndexBookJob) — the
            four states below cover every fulltext_enabled x has_fulltext
            combination. %>
        <% if !@book.fulltext_enabled? && @book.has_fulltext? %>
          <%# "Remove from index" flips fulltext_enabled off immediately, but
              has_fulltext stays true until the queued IndexBookJob clears
              the row — without this state the book would show the opt-in
              button while its text is actually still stored and searchable. %>
          <span class="stamp stamp--pending">removal pending</span>
          <%= button_to reindex_book_path(@book), class: "btn btn--quiet",
                title: "Cancel the pending removal and keep this book's text in the search index" do %>
            <%= render "shared/icon", name: "text-search" %>Keep in index
          <% end %>
        <% elsif !@book.fulltext_enabled? %>
          <%= button_to reindex_book_path(@book), class: "btn btn--quiet",
                title: "Extract the book's text with Calibre so search can look inside it" do %>
            <%= render "shared/icon", name: "text-search" %>Index full text
          <% end %>
        <% elsif @book.has_fulltext? %>
          <span class="stamp stamp--ready">in search index</span>
          <%= button_to unindex_book_path(@book), class: "btn btn--quiet",
                title: "Remove the extracted text from the search index" do %>
            <%= render "shared/icon", name: "x" %>Remove from index
          <% end %>
        <% else %>
          <span class="stamp stamp--pending">indexing pending</span>
          <%= button_to reindex_book_path(@book), class: "btn btn--quiet",
                title: "Retry Calibre text extraction" do %>
            <%= render "shared/icon", name: "text-search" %>Re-run
          <% end %>
          <%= button_to unindex_book_path(@book), class: "btn btn--quiet",
                title: "Opt this book back out of the search index" do %>
            <%= render "shared/icon", name: "x" %>Remove from index
          <% end %>
        <% end %>
        <%# Only offered when the candidate pdf is actually what the browser
            reader would open: on a mixed-format book (e.g. epub + pdf),
            #readable_file prefers the epub, so an OCR'd pdf companion would
            be used by neither reading (#readable_file/#read_source_path)
            nor search (IndexBookJob::TEXT_SOURCE_PREFERENCE) — dead weight
            the button shouldn't promise. %>
        <% if (candidate = @book.ocr_candidate_file) && !candidate.ocr_fresh? && @book.readable_file == candidate %>
          <%= button_to book_conversions_path(@book, kind: "ocr"), class: "btn btn--quiet",
                title: "Adds a searchable, selectable text layer to the scanned PDF — takes a few minutes" do %>
            <%= render "shared/icon", name: "scan-text" %>OCR text layer
          <% end %>
        <% end %>
        <span class="action-row__spacer"></span>
        <%= button_to book_path(@book), method: :delete, class: "btn btn--danger",
              form: { data: { turbo_confirm: "Delete “#{@book.title}” and all its files?" } } do %>
          <%= render "shared/icon", name: "trash" %>Delete
        <% end %>
      </div>
    </div>
  </div>
</div>

<% if @book.description.present? %>
  <p class="section-label">About</p>
  <p class="book-description"><%= simple_format(@book.description) %></p>
<% end %>

<% if @similar.any? %>
  <p class="section-label">Similar books</p>
  <div class="shelf shelf--similar">
    <% @similar.each do |book| %>
      <%= link_to book_path(book), class: "shelf-item", title: book.title do %>
        <%= render "cover", book: book %>
        <span class="shelf-caption">
          <span class="t"><%= book.title %></span>
          <span class="a"><%= book.display_author %></span>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>

<% reading_states = @book.reading_states.includes(:device).order(content_mtime: :desc) %>
<% if reading_states.any? %>
  <p class="section-label">Reading</p>
  <% reading_states.each_with_index do |state, index| %>
    <div class="file-row">
      <span class="stamp <%= index.zero? ? "stamp--ready" : "" %>"><%= state.device.name %></span>
      <span class="grow small">
        <% if state.progress_percent %>
          <span class="progress-track progress-track--wide" role="img" aria-label="approximately <%= state.progress_percent.round %> percent read"><span class="progress-fill" style="width: <%= state.progress_percent.clamp(2, 100) %>%"></span></span>
          <b>~<%= state.progress_percent.round %>%</b>
        <% end %>
        <span class="muted">
          <% if state.last_position %> position <%= number_with_delimiter(state.last_position) %> ·<% end %>
          read <%= time_ago_in_words(state.content_mtime) %> ago
          <% if state.annotation_count.to_i.positive? %> · <%= pluralize(state.annotation_count, "bookmark") %><% end %>
          <% if index.zero? && reading_states.size > 1 %> · furthest<% end %>
        </span>
      </span>
    </div>
  <% end %>
<% end %>

<% if @annotations.any? %>
  <p class="section-label">
    Highlights &amp; notes (<%= @annotations.size %>)
    <span class="muted small">· <%= link_to "all notes", annotations_path %></span>
  </p>
  <% @annotations.each do |annotation| %>
    <blockquote class="annotation">
      <p class="annotation-content"><%= annotation.content %></p>
      <footer class="small muted">
        <span class="stamp <%= annotation.kind == "note" ? "stamp--pending" : "stamp--ready" %>"><%= annotation.kind %></span>
        <% if annotation.location_label %><%= location_label_html(annotation) %> · <% end %><%
        %><% if annotation.added_at %><%= l annotation.added_at.to_date, format: :long %> · <% end %><%
        %><%= annotation.device.name %>
      </footer>
    </blockquote>
  <% end %>
<% end %>

<% if @vocab_entries.any? %>
  <p class="section-label">
    Vocab (<%= @vocab_entries.size %>)
    <span class="muted small">· <%= link_to "all vocab for this book", vocab_entries_path(book_id: @book.id) %></span>
  </p>
  <%= render partial: "vocab_entries/entry", collection: @vocab_entries, as: :entry %>
<% end %>

<%= turbo_frame_tag "book_files" do %>
  <% if @conversions.any?(&:pending?) || @conversions.any?(&:running?) %>
    <%# Reloads this frame while work is in flight; the attribute disappears
        with the next render once every conversion settles. %>
    <div data-controller="poll" data-poll-interval-value="4000"></div>
  <% end %>

  <p class="section-label">Files</p>
  <% @book.book_files.order(:format).each do |file| %>
    <div class="file-row">
      <%= link_to file.format, root_path(format: file.format),
            class: "stamp stamp--link #{"stamp--ready" if file.kindle_ready?}",
            title: "All books available as #{file.format.upcase}", data: { turbo_frame: "_top" } %>
      <% unless file.available? %>
        <span class="stamp stamp--failed" title="The scanned source file is no longer at <%= file.path %>">missing</span>
      <% end %>
      <% if file.ocr_fresh? %>
        <% ocr_stamp_title = @book.readable_file == file ?
             "OCR text layer present — search and the browser reader use it" :
             "OCR text layer present (a richer format is preferred for reading and search)" %>
        <span class="stamp stamp--ready" title="<%= ocr_stamp_title %>">text layer</span>
      <% end %>
      <% if file.text_fresh? %>
        <span class="stamp stamp--ready" title="Plain-text reflow companion present (see Library::TextCompanion)">text only</span>
      <% end %>
      <span class="grow small muted"><%= format_size(file.size) %> · <%= file.source %></span>
      <% if file.available? %>
        <%= link_to download_book_path(@book, fmt: file.format), class: "btn btn--quiet", data: { turbo: false } do %>
          <%= render "shared/icon", name: "download" %>Download
        <% end %>
        <%# The main link above now serves the OCR'd bytes for this row — offer
            the untouched scan too, for whoever specifically wants it. %>
        <% if file.ocr_fresh? %>
          <%= link_to "original", download_book_path(@book, fmt: file.format, raw: 1),
                class: "small muted", data: { turbo: false }, title: "Download the untouched scan, without the OCR text layer" %>
        <% end %>
        <% if file.text_fresh? %>
          <%= link_to "text only", download_book_path(@book, fmt: file.format, text: 1),
                class: "small muted", data: { turbo: false }, title: "Download the plain-text reflow version" %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# TXT is deliberately excluded (see Conversion::OFFERED_TARGET_FORMATS) —
      "Build text version" above (Library::TextCompanion) is the supported
      reflow path; a plain ebook-convert txt target can silently fail on a
      scanned/OCR'd pdf (see ConvertBookJob::MIN_OUTPUT_SIZE). %>
  <% convertible = Conversion::OFFERED_TARGET_FORMATS - @book.formats %>
  <% if convertible.any? && @book.book_files.any? %>
    <p class="section-label">Convert to</p>
    <div class="actions">
      <% convertible.each do |target| %>
        <%= button_to target.upcase, book_conversions_path(@book, target_format: target), class: "btn btn--quiet" %>
      <% end %>
    </div>
  <% end %>

  <% if @conversions.any? %>
    <p class="section-label">Conversion log</p>
    <% @conversions.each do |conversion| %>
      <div class="conversion-row">
        <span class="<%= conversion_stamp_class(conversion) %>"><%= conversion.status %></span>
        <span class="grow small">
          <% if conversion.ocr? %>
            <%= render "shared/icon", name: "scan-text" %>OCR · text layer
          <% else %>
            <%= conversion.book_file.format.upcase %> → <%= conversion.target_format.upcase %>
          <% end %>
          <% if conversion.failed? && conversion.error.present? %>
            <span class="muted mono small"> — <%= truncate(conversion.error, length: 160) %></span>
          <% end %>
        </span>
        <span class="small muted"><%= time_ago_in_words(conversion.created_at) %> ago</span>
      </div>
      <%# Full Calibre output (up to 4000 bytes, see Conversion#mark_failed!) —
          the row above only shows a 160-char fragment, not enough to see why
          a conversion actually failed. Native <details> needs no JS and
          matches the disclosure pattern the Shelves nav already uses. %>
      <% if conversion.failed? && conversion.error.present? %>
        <details class="conversion-error">
          <summary>Show full error</summary>
          <pre class="conversion-error__pre mono"><%= conversion.error %></pre>
        </details>
      <% end %>
    <% end %>
  <% end %>
<% end %>
