<% content_for :title, "#{@book.title} — Folio" %>
<%= turbo_stream_from @book %>

<div class="book-sheet">
  <%= render "cover", book: @book %>

  <div>
    <% if @book.series.present? %>
      <p class="kicker">
        <%= link_to @book.series, root_path(series: @book.series) %>
        <%= @book.series_index&.round == @book.series_index ? @book.series_index&.to_i : @book.series_index %>
      </p>
    <% else %>
      <p class="kicker">In the library</p>
    <% end %>
    <h1 class="page-title"><%= @book.title %></h1>
    <% if @book.category.present? %>
      <p class="breadcrumb">
        <%= link_to Library::Taxonomy.label_for(@book.category_root), root_path(category_root: @book.category_root) %>
        <% if @book.category_parts.size > 1 %>
          <span aria-hidden="true"> / </span>
          <%= link_to Library::Taxonomy.sub_label_for(@book.category_root, @book.category_parts.last), root_path(category: @book.category) %>
        <% end %>
      </p>
    <% end %>
    <p class="book-author">
      <% if @book.author.present? %>
        <%= link_to @book.author, root_path(author: @book.author, sort: "title") %>
      <% else %>
        <%= @book.display_author %>
      <% end %>
    </p>

    <%# Each fact links to the library filtered on it, like the author. %>
    <p class="meta-list small">
      <% if @book.language.present? %>
        <%= link_to tag.b(@book.language), root_path(language: @book.language),
              title: "All books in this language" %> ·
      <% end %>
      <% if @book.published_year.present? %>
        <%= link_to @book.published_year, root_path(year: @book.published_year),
              title: "All books published in #{@book.published_year}" %> ·
      <% end %>
      <%= link_to "added #{l @book.created_at.to_date, format: :long}",
            root_path(added: @book.created_at.to_date.iso8601),
            title: "Everything added that day" %>
    </p>

    <div class="actions">
      <% @devices.each do |device| %>
        <% delivery = @deliveries[device.id] %>
        <% preferred = device.id == @preferred_device_id %>
        <% if delivery.nil? || delivery.removed? %>
          <%= button_to "Send to #{device.name}#{preferred ? " (Preferred)" : ""}", deliveries_path(book_id: @book.id, device_id: device.id),
                class: "btn btn--primary" %>
        <% elsif delivery.evict_requested? %>
          <%= button_to "Removing from #{device.name}… keep",
                eviction_path(delivery_id: delivery.id), method: :delete, class: "btn btn--quiet",
                title: "Queued for deletion on next sync — click to keep it" %>
        <% elsif delivery.delivered? %>
          <%= button_to "On #{device.name}#{preferred ? " ★" : ""} ✕", evictions_path(delivery_id: delivery.id), class: "btn btn--quiet",
                title: "Delete from the device on next sync",
                form: { data: { turbo_confirm: "Delete “#{@book.title}” from #{device.name} on next sync?" } } %>
        <% else %>
          <%= button_to "Queued for #{device.name}#{preferred ? " ★" : ""} ✕",
                delivery_path(delivery), method: :delete, class: "btn btn--quiet",
                title: "Remove from queue" %>
        <% end %>
        <% if preferred && (delivery.nil? || delivery.removed?) %>
          <span class="stamp stamp--ready">Preferred</span>
        <% end %>
      <% end %>
      <% if @book.readable_file || @book.book_files.any? %>
        <%= link_to "Read in browser", read_book_path(@book), class: "btn btn--primary" %>
      <% end %>
      <% if (kindle_file = @book.kindle_file) %>
        <%= link_to "Download #{kindle_file.format.upcase}",
              download_book_path(@book, fmt: kindle_file.format),
              class: "btn #{"btn--primary" if @devices.empty?}", data: { turbo: false } %>
      <% end %>
      <%= link_to "Edit", edit_book_path(@book), class: "btn btn--quiet" %>
      <%= button_to "Index full text", reindex_book_path(@book), class: "btn btn--quiet",
            title: "Extract the book's text with Calibre so search can look inside it" %>
      <%= button_to "Delete", book_path(@book), method: :delete, class: "btn btn--danger",
            form: { data: { turbo_confirm: "Delete “#{@book.title}” and all its files?" } } %>
    </div>
  </div>
</div>

<% if @book.description.present? %>
  <p class="section-label">About</p>
  <p class="book-description"><%= simple_format(@book.description) %></p>
<% end %>

<% if @similar.any? %>
  <p class="section-label">Similar books</p>
  <div class="shelf shelf--similar">
    <% @similar.each do |book| %>
      <%= link_to book_path(book), class: "shelf-item", title: book.title do %>
        <%= render "cover", book: book %>
        <span class="shelf-caption">
          <span class="t"><%= book.title %></span>
          <span class="a"><%= book.display_author %></span>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>

<% reading_states = @book.reading_states.includes(:device).order(content_mtime: :desc) %>
<% if reading_states.any? %>
  <p class="section-label">Reading</p>
  <% reading_states.each_with_index do |state, index| %>
    <div class="file-row">
      <span class="stamp <%= index.zero? ? "stamp--ready" : "" %>"><%= state.device.name %></span>
      <span class="grow small">
        <% if state.progress_percent %>
          <span class="progress-track progress-track--wide" role="img" aria-label="approximately <%= state.progress_percent.round %> percent read"><span class="progress-fill" style="width: <%= state.progress_percent.clamp(2, 100) %>%"></span></span>
          <b>~<%= state.progress_percent.round %>%</b>
        <% end %>
        <span class="muted">
          <% if state.last_position %> position <%= number_with_delimiter(state.last_position) %> ·<% end %>
          read <%= time_ago_in_words(state.content_mtime) %> ago
          <% if state.annotation_count.to_i.positive? %> · <%= pluralize(state.annotation_count, "bookmark") %><% end %>
          <% if index.zero? && reading_states.size > 1 %> · furthest<% end %>
        </span>
      </span>
    </div>
  <% end %>
<% end %>

<% if @annotations.any? %>
  <p class="section-label">
    Highlights &amp; notes (<%= @annotations.size %>)
    <span class="muted small">· <%= link_to "all notes", annotations_path %></span>
  </p>
  <% @annotations.each do |annotation| %>
    <blockquote class="annotation">
      <p class="annotation-content"><%= annotation.content %></p>
      <footer class="small muted">
        <span class="stamp <%= annotation.kind == "note" ? "stamp--pending" : "stamp--ready" %>"><%= annotation.kind %></span>
        <% if annotation.location_label %><%= location_label_html(annotation) %> · <% end %><%
        %><% if annotation.added_at %><%= l annotation.added_at.to_date, format: :long %> · <% end %><%
        %><%= annotation.device.name %>
      </footer>
    </blockquote>
  <% end %>
<% end %>

<% if @vocab_entries.any? %>
  <p class="section-label">
    Vocab (<%= @vocab_entries.size %>)
    <span class="muted small">· <%= link_to "all vocab for this book", vocab_entries_path(book_id: @book.id) %></span>
  </p>
  <%= render partial: "vocab_entries/entry", collection: @vocab_entries, as: :entry %>
<% end %>

<%= turbo_frame_tag "book_files" do %>
  <% if @conversions.any?(&:pending?) || @conversions.any?(&:running?) %>
    <%# Reloads this frame while work is in flight; the attribute disappears
        with the next render once every conversion settles. %>
    <div data-controller="poll" data-poll-interval-value="4000"></div>
  <% end %>

  <p class="section-label">Files</p>
  <% @book.book_files.order(:format).each do |file| %>
    <div class="file-row">
      <%= link_to file.format, root_path(format: file.format),
            class: "stamp #{"stamp--ready" if file.kindle_ready?}",
            title: "All books available as #{file.format.upcase}", data: { turbo_frame: "_top" } %>
      <% unless file.available? %>
        <span class="stamp stamp--failed" title="The scanned source file is no longer at <%= file.path %>">missing</span>
      <% end %>
      <span class="grow small muted"><%= format_size(file.size) %> · <%= file.source %></span>
      <% if file.available? %>
        <%= link_to "Download", download_book_path(@book, fmt: file.format),
              class: "btn btn--quiet", data: { turbo: false } %>
      <% end %>
    </div>
  <% end %>

  <% convertible = Conversion::TARGET_FORMATS - @book.formats %>
  <% if convertible.any? && @book.book_files.any? %>
    <p class="section-label">Convert to</p>
    <div class="actions">
      <% convertible.each do |target| %>
        <%= button_to target.upcase, book_conversions_path(@book, target_format: target), class: "btn" %>
      <% end %>
    </div>
  <% end %>

  <% if @conversions.any? %>
    <p class="section-label">Conversion log</p>
    <% @conversions.each do |conversion| %>
      <div class="conversion-row">
        <span class="<%= conversion_stamp_class(conversion) %>"><%= conversion.status %></span>
        <span class="grow small">
          <%= conversion.book_file.format.upcase %> → <%= conversion.target_format.upcase %>
          <% if conversion.failed? && conversion.error.present? %>
            <span class="muted mono small"> — <%= truncate(conversion.error, length: 160) %></span>
          <% end %>
        </span>
        <span class="small muted"><%= time_ago_in_words(conversion.created_at) %> ago</span>
      </div>
      <%# Full Calibre output (up to 4000 bytes, see Conversion#mark_failed!) —
          the row above only shows a 160-char fragment, not enough to see why
          a conversion actually failed. Native <details> needs no JS and
          matches the disclosure pattern the Shelves nav already uses. %>
      <% if conversion.failed? && conversion.error.present? %>
        <details class="conversion-error">
          <summary>Show full error</summary>
          <pre class="conversion-error__pre mono"><%= conversion.error %></pre>
        </details>
      <% end %>
    <% end %>
  <% end %>
<% end %>
