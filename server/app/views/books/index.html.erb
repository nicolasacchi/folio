<% content_for :title, "Folio — library" %>

<%= form_with url: root_path, method: :get, class: "search-bar", role: "search" do %>
  <%= search_field_tag :q, @query, placeholder: "Search titles, authors, full text…",
        autocomplete: "off", "aria-label": "Search the library" %>
  <button class="btn" type="submit">Search</button>
<% end %>

<% if @query.present? %>
  <p class="kicker">
    Results for “<%= @query %>”
    <span class="mode-toggle" role="group" aria-label="Search mode">
      · <%= @mode == "title" ? tag.b("titles", "aria-current": "true") : link_to("titles", root_path(q: @query), title: "Match titles, authors and series") %>
      / <%= @mode == "full" ? tag.b("full text", "aria-current": "true") : link_to("full text", root_path(q: @query, mode: "full"), title: "Also search descriptions and inside the books") %>
      <% if @semantic_available %>
        / <%= @mode == "semantic" ? tag.b("meaning", "aria-current": "true") : link_to("meaning", root_path(q: @query, mode: "semantic")) %>
      <% end %>
    </span>
  </p>
  <%# Turbo navigates mode-toggle links via DOM morph (turbo_refreshes_with
      method: :morph in the layout), so this node persists across the visit
      and its text change is what triggers the live-region announcement —
      not a fresh page load, which screen readers wouldn't announce. %>
  <p class="sr-only" aria-live="polite" aria-atomic="true"><%= search_mode_announcement(@mode) %></p>

  <% if @mode == "semantic" %>
    <% if @semantic_books.empty? %>
      <div class="empty-state">
        <span class="fleuron">❧</span>
        Nothing similar enough in the library.<br>
        <%= link_to "Back to all books", root_path %>
      </div>
    <% else %>
      <% @semantic_books.each do |book| %>
        <%= link_to book_path(book), class: "search-hit" do %>
          <%= render "cover", book: book %>
          <span class="grow">
            <span class="search-hit-title"><%= book.title %></span>
            <span class="book-author"> — <%= book.display_author %></span>
            <% if @semantic_snippets[book.id].present? %>
              <span class="search-hit-snippet"><%= sanitize(@semantic_snippets[book.id], tags: %w[mark]) %></span>
            <% end %>
          </span>
        <% end %>
      <% end %>
    <% end %>
  <% elsif @hits.empty? %>
    <div class="empty-state">
      <span class="fleuron">❧</span>
      No <%= @mode == "full" ? "book" : "title or author" %> matches that.<br>
      <% if @mode == "title" %>
        <%= link_to "Search the full text too", root_path(q: @query, mode: "full") %> ·
      <% end %>
      <% if @semantic_available %>
        <%= link_to "Try searching by meaning", root_path(q: @query, mode: "semantic") %> ·
      <% end %>
      <%= link_to "Back to all books", root_path %>
    </div>
  <% else %>
    <% @hits.each do |hit| %>
      <%= link_to book_path(hit.book), class: "search-hit" do %>
        <%= render "cover", book: hit.book %>
        <span class="grow">
          <span class="search-hit-title"><%= hit.book.title %></span>
          <span class="book-author"> — <%= hit.book.display_author %></span>
          <% if hit.snippet.present? %>
            <span class="search-hit-snippet"><%= sanitize(hit.snippet, tags: %w[mark]) %></span>
          <% end %>
        </span>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <div class="toolbar">
    <%= form_with url: root_path, method: :get, class: "toolbar-form" do %>
      <%= hidden_field_tag :author, @author if @author %>
      <%= hidden_field_tag :series, @series if @series %>
      <%= hidden_field_tag :year, @year if @year %>
      <%= hidden_field_tag :language, @language if @language %>
      <%= hidden_field_tag :added, @added.iso8601 if @added %>
      <%= hidden_field_tag :category, @category if @category %>
      <%= hidden_field_tag :category_root, @category_root if @category_root %>
      <%= select_tag :sort,
            options_for_select([ [ "Recently added", "recent" ], [ "By title", "title" ], [ "By author", "author" ] ], @sort),
            onchange: "this.form.requestSubmit()", "aria-label": "Sort order" %>
      <%= select_tag :format,
            options_for_select([ [ "All formats", "" ] ] + BookFile.distinct.pluck(:format).sort.map { |f| [ f.upcase, f ] }, @format),
            onchange: "this.form.requestSubmit()", "aria-label": "Filter by format" %>
      <noscript><button class="btn btn--quiet" type="submit">Apply</button></noscript>
    <% end %>
    <% if @stats %>
      <span class="muted small toolbar-stats">
        <%= number_with_delimiter(@stats[:books]) %> books ·
        <%= number_with_delimiter(@stats[:files]) %> files ·
        <%= format_size(@stats[:bytes]) %>
      </span>
    <% end %>
  </div>

  <% if @shelves.any? || @inbox_count.positive? || @uncategorized_count.positive? %>
    <nav class="shelves" aria-label="Shelves">
      <p class="section-label">Shelves</p>
      <% if @category || @category_root %>
        <p class="shelves-clear">
          <%= link_to "All books", url_for(request.query_parameters.except("category", "category_root", "page")),
                class: "btn btn--quiet" %>
        </p>
      <% end %>
      <% @shelves.each do |root| %>
        <% root_active = @category_root == root[:key] || @category == root[:key] || (@category && @category.start_with?("#{root[:key]}/")) %>
        <details class="shelf-root" <%= "open" if root_active %>>
          <summary>
            <%= link_to root[:label], root_path(category_root: root[:key]),
                  class: "shelf-root-link #{"is-active" if @category_root == root[:key]}" %>
            <span class="muted small">(<%= number_with_delimiter(root[:total]) %>)</span>
          </summary>
          <ul class="shelf-subs">
            <% root[:subs].each do |sub| %>
              <li>
                <%= link_to root_path(category: sub[:key]), class: "#{"is-active" if @category == sub[:key]}" do %>
                  <%= sub[:label] %> <span class="muted">(<%= number_with_delimiter(sub[:count]) %>)</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </details>
      <% end %>
      <% if @inbox_count.positive? %>
        <p class="shelf-flat">
          <%= link_to "Inbox", root_path(category: "_inbox"), class: "#{"is-active" if @category == "_inbox"}" %>
          <span class="muted small">(<%= number_with_delimiter(@inbox_count) %>)</span>
        </p>
      <% end %>
      <% if @uncategorized_count.positive? %>
        <p class="shelf-flat">
          <%= link_to "Uncategorized", root_path(category: BooksController::UNCATEGORIZED),
                class: "#{"is-active" if @category == BooksController::UNCATEGORIZED}" %>
          <span class="muted small">(<%= number_with_delimiter(@uncategorized_count) %>)</span>
        </p>
      <% end %>
    </nav>
  <% end %>

  <% active_filters = { author: @author, series: @series, format: @format,
                        year: @year, language: @language, added: @added,
                        category: @category, category_root: @category_root }.compact %>
  <% if active_filters.any? %>
    <p class="chips">
      <% active_filters.each do |key, value| %>
        <%= link_to url_for(request.query_parameters.except(key.to_s, "page")), class: "stamp stamp--ready chip",
              title: "Remove #{key} filter" do %>
          <%= key.to_s.tr("_", " ") %>: <%= key.in?([ :category, :category_root ]) ? category_label(value) : value %> ✕
        <% end %>
      <% end %>
    </p>
  <% end %>

  <% if @currently_reading.present? %>
    <p class="section-label">Keep reading</p>
    <div class="shelf shelf--similar shelf--reading">
      <% @currently_reading.each do |book, state| %>
        <%= link_to book_path(book), class: "shelf-item", title: book.title do %>
          <%= render "cover", book: book %>
          <span class="shelf-caption">
            <span class="t"><%= book.title %></span>
            <span class="a">
              <% if state.progress_percent %>~<%= state.progress_percent.round %>% · <% end %><%
              %><%= time_ago_in_words(state.content_mtime) %> ago · <%= state.device.name %>
            </span>
            <% if state.progress_percent %>
              <span class="progress-track"><span class="progress-fill" style="width: <%= state.progress_percent.clamp(2, 100) %>%"></span></span>
            <% end %>
          </span>
        <% end %>
      <% end %>
    </div>
    <p class="section-label">Library</p>
  <% end %>

  <% if @books.empty? %>
    <div class="empty-state">
      <span class="fleuron">❧</span>
      <% if active_filters.any? %>
        No books match these filters.<br>
        <%= link_to "Clear filters", root_path %>
      <% else %>
        The shelves are empty.<br>
        <%= link_to "Add your first book", new_upload_path %>
        or <%= link_to "scan the library folder", library_scan_path %>
      <% end %>
    </div>
  <% else %>
    <div class="shelf">
      <% @books.each do |book| %>
        <%= link_to book_path(book), class: "shelf-item", title: book.title do %>
          <%= render "cover", book: book, flagged: book.conversion_failed_without_deliverable? %>
          <span class="shelf-caption">
            <span class="t"><%= book.title %></span>
            <span class="a"><%= book.display_author %></span>
          </span>
        <% end %>
      <% end %>
    </div>

    <% if @last_page > 1 %>
      <nav class="pager" aria-label="Pagination">
        <% if @page > 1 %>
          <%= link_to "← Prev", url_for(request.query_parameters.merge("page" => @page - 1)), class: "btn btn--quiet" %>
        <% end %>
        <span class="muted small">page <%= @page %> of <%= number_with_delimiter(@last_page) %></span>
        <% if @page < @last_page %>
          <%= link_to "Next →", url_for(request.query_parameters.merge("page" => @page + 1)), class: "btn btn--quiet" %>
        <% end %>
      </nav>
    <% end %>
  <% end %>
<% end %>
