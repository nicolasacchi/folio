<% content_for :title, "Folio — duplicates" %>

<p class="kicker">Housekeeping</p>
<h1 class="page-title">Duplicate editions</h1>

<p class="muted small">
  Exact copies (same checksum) never enter the library twice. These are different
  files sharing a title and author — merge them to gather all formats on one book,
  or delete the surplus edition from its page.
</p>

<% if @groups.empty? %>
  <div class="empty-state">
    <span class="fleuron">❧</span>
    No duplicate editions found.
  </div>
<% else %>
  <div class="toolbar">
    <p class="muted small" style="margin: 0;"><%= number_with_delimiter(@total_groups) %> groups</p>
    <%= button_to "Merge all groups", catalog_merge_duplicates_path, class: "btn",
          form: { data: { turbo_confirm: "Merge every duplicate-editions group into its best edition (most formats, then cover, then oldest)? Conflicting formats stay put; source-folder files are never touched." } } %>
  </div>

  <% @groups.each do |group| %>
    <p class="section-label"><%= group.first.title %> — <%= group.first.display_author %></p>
    <% group.each do |book| %>
      <div class="file-row">
        <%= link_to book_path(book), class: "duplicate-cover" do %>
          <%= render "books/cover", book: book %>
        <% end %>
        <span class="grow small">
          <%= link_to book.title, book_path(book) %><br>
          <span class="muted mono small">
            <%= book.formats.map(&:upcase).join(" · ") %> ·
            <%= format_size(book.book_files.sum(&:size)) %> ·
            added <%= l book.created_at.to_date %>
          </span>
        </span>
        <%= button_to "Merge others into this", merge_duplicates_path(target_id: book.id, source_ids: (group - [ book ]).map(&:id)),
              class: "btn btn--quiet",
              form: { data: { turbo_confirm: "Merge #{group.size - 1} other edition(s) into “#{book.title}”? Non-conflicting formats move over; emptied books are deleted." } } %>
      </div>
    <% end %>
  <% end %>

  <% if @last_page > 1 %>
    <nav class="pager" aria-label="Pagination">
      <% if @page > 1 %>
        <%= link_to "← Prev", url_for(request.query_parameters.merge("page" => @page - 1)), class: "btn btn--quiet" %>
      <% end %>
      <span class="muted small">page <%= @page %> of <%= number_with_delimiter(@last_page) %></span>
      <% if @page < @last_page %>
        <%= link_to "Next →", url_for(request.query_parameters.merge("page" => @page + 1)), class: "btn btn--quiet" %>
      <% end %>
    </nav>
  <% end %>
<% end %>
