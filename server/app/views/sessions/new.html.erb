<% content_for :title, "Sign in — Folio" %>

<div class="auth-page">
  <div class="auth-card">
    <p class="wordmark">Folio<span class="fleuron">&nbsp;❧</span></p>
    <p class="kicker">Private library</p>

    <%= form_with url: session_path do |form| %>
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", value: params[:email_address] %>

      <%= form.label :password %>
      <%= form.password_field :password, required: true,
            autocomplete: "current-password", maxlength: 72 %>

      <div class="actions">
        <%= form.submit "Sign in", class: "btn btn--primary" %>
      </div>
    <% end %>
  </div>
</div>
