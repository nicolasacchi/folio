<% content_for :title, "Upload — Folio" %>

<p class="kicker">Acquisitions</p>
<h1 class="page-title">Add books</h1>
<p class="muted small">
  EPUB, AZW3, MOBI, PDF, KFX, TXT, CBZ, DOCX and friends. Metadata and the
  cover are read automatically; anything without a Kindle-ready format is
  converted to AZW3 in the background.
</p>

<%= form_with url: uploads_path, multipart: true do %>
  <label class="dropzone" data-controller="file-picker">
    <i class="dz-icon">❧</i>
    <span data-file-picker-target="prompt">
      Tap to choose files<span class="muted"> — or drop them here</span>
    </span>
    <div class="dz-files"><ul data-file-picker-target="list"></ul></div>
    <%= file_field_tag "files[]", multiple: true, data: { file_picker_target: "input", action: "change->file-picker#update" },
          accept: BookFile::FORMATS.map { |f| ".#{f}" }.join(",") %>
  </label>

  <div class="actions">
    <button class="btn btn--primary" type="submit">Add to library</button>
  </div>
<% end %>
