# Local capture output can contain device/account data.
observer/captures/
observer/tmp/

# Kindle-derived proprietary or sensitive temporary material.
privatecloud/tmp/
privatecloud/__pycache__/
*.py[cod]
*.db
*.sqlite
*.sqlite3

# Local book libraries and generated downloads (repo root only — the
# Rails app has legitimate books/ view and controller directories).
/books/
/documents/
/PrivateCloud/

# Editor/OS noise.
.DS_Store
*~
*.swp

# Python bytecode caches anywhere in the tree.
__pycache__/

# Environment files and key material must never be committed.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
id_rsa*
id_ed25519*

# Rust build output.
kindled/target/

# grokclaude offload blackboard (job briefs/reports/scratch — local run records).
.grokclaude/

# Local agent config (machine-specific permissions).
.claude/
